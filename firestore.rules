rules_version = '2';
// Beat Relay security rules.
// - groups/{group}: the shared "current build" link + meta. Any signed-in user may
//   read (so group members see their build) and write (update the link).
// - attendees/{uid}: name + EMAIL + group. The owner writes only their own record;
//   ONLY the moderator can read it (protects everyone's email / the roster).
// - activity/{id}: the who-did-what log. Any signed-in user may add an entry;
//   ONLY the moderator can read the log.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isModerator() {
      return signedIn() && request.auth.token.email == "calharrisinc@gmail.com";
    }

    match /groups/{group} {
      allow read:   if signedIn();
      allow create: if signedIn();
      // Baton safeguard: anyone may take/pass the baton (writes not changing buildLink),
      // but changing the build link requires HOLDING the baton — or being the moderator
      // (restore-to-a-version / free-the-baton).
      allow update: if signedIn() && (
        isModerator()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['buildLink'])
        || request.auth.uid == resource.data.batonUid
      );
      allow delete: if isModerator();

      // Immutable, append-only build history — no version is ever overwritten.
      match /builds/{buildId} {
        allow read:   if signedIn();
        allow create: if signedIn();
        allow update: if false;
        allow delete: if isModerator();
      }
    }

    match /attendees/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read, delete:   if isModerator();
    }

    match /activity/{id} {
      allow create:         if signedIn();
      allow read, update, delete: if isModerator();
    }

    // Workshop settings (just the group count). Public read so the sign-in dropdown can
    // populate before anyone signs in; only the moderator may change it.
    match /config/{doc} {
      allow read:  if true;
      allow write: if isModerator();
    }
  }
}
